{
  "name": "office-days",
  "version": "0.1.1",
  "description": "Track WFH and Office attendance (Cloudflare edge)",
  "main": "src/index.tsx",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute office_days --local --file=./schema.sql",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "wfh",
    "office-days",
    "cloudflare"
  ],
  "author": "Prasenjeet Dutta",
  "license": "MIT",
  "dependencies": {
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240208.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.83.0"
  }
}
